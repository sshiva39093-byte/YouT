        {PKGS.map((p) => (
          <button key={p.inr} onClick={() => setPkg(p)} className={`rounded-2xl border-2 bg-white p-4 text-left ${pkg.inr === p.inr ? "border-ink" : "border-line"}`}>
            <p className="text-2xl font-bold">₹{p.inr}</p><p className="text-sm text-muted">{fmt(p.coins)} coins</p>
