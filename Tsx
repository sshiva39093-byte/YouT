  useEffect(() => { loadRows(); }, []);
  const q = `pa=${UPI}&pn=WatchEarn&am=${pkg.inr}.00&cu=INR&tn=WatchEarn%20${pkg.inr}`;
  async function submit() {
    setMsg(null);
