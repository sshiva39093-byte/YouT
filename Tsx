function Watch({ camp, onExit }: any) {
  const wrap = useRef<HTMLDivElement>(null);
  const player = useRef<any>(null);
  const sid = useRef<string | null>(null);
  const playing = useRef(false); const checking = useRef(false);
  const secs = useRef(0); const since = useRef(0);
  const [err, setErr] = useState(""); const [earned, setEarned] = useState(0);
  const [prog, setProg] = useState(0); const [check, setCheck] = useState(false);
  const [left, setLeft] = useState(20); const [done, setDone] = useState(false);

  async function credit() {
    const { error } = await supabase.rpc("credit_minute", { p_session: sid.current });
    if (error) { if (/finished/i.test(error.message)) { setDone(true); player.current?.pauseVideo(); } return; }
    setEarned((n) => n + 1);
  }

  useEffect(() => {
    let timer: any; let dead = false;
    (async () => {
      const s = await supabase.rpc("start_watch", { p_campaign: camp.id });
      if (s.error) return setErr(s.error.message);
      if (dead) return;
      sid.current = s.data;
      const w = window as any;
      const make = () => {
        const el = document.createElement("div");
        wrap.current?.appendChild(el);
        player.current = new w.YT.Player(el, {
          videoId: camp.youtube_id, width: "100%", height: "100%",
          playerVars: { rel: 0, modestbranding: 1, playsinline: 1 },
          events: { onStateChange: (e: any) => { playing.current = e.data === 1; } },
        });
      };
      if (w.YT?.Player) make();
      else { w.onYouTubeIframeAPIReady = make; const t = document.createElement("script"); t.src = "https://www.youtube.com/iframe_api"; document.body.appendChild(t); }
      timer = setInterval(() => {
        if (!playing.current || checking.current || document.visibilityState !== "visible") return;
        secs.current += 1; since.current += 1; setProg(secs.current);
        if (secs.current >= 60) { secs.current = 0; setProg(0); credit(); }
        if (since.current >= 180) { checking.current = true; player.current?.pauseVideo(); setLeft(20); setCheck(true); }
      }, 1000);
    })();
    return () => { dead = true; clearInterval(timer); player.current?.destroy?.(); };
  }, []);

  useEffect(() => {
    if (!check) return;
    const t = setInterval(() => setLeft((l) => l - 1), 1000);
    return () => clearInterval(t);
  }, [check]);
  useEffect(() => {
    if (check && left <= 0) { setCheck(false); checking.current = false; since.current = 0; }
  }, [left, check]);

  return (
    <div className="px-5 pt-6">
      <button onClick={onExit} className="mb-3 text-sm text-muted underline">Back</button>
      <div ref={wrap} className="aspect-video w-full overflow-hidden rounded-2xl bg-black [&_iframe]:h-full [&_iframe]:w-full" />
      <h1 className="mt-4 font-medium">{camp.title}</h1>
      <Err t={err} />
      <div className="mt-5 rounded-2xl border border-line bg-white p-4">
        <div className="flex items-center justify-between">
          <p className="text-sm text-muted">Earned this video</p>
          <p className="text-2xl font-bold text-coin-dark">+{earned} coins</p>
        </div>
        <div className="mt-3 h-2 overflow-hidden rounded-full bg-line"><div className="h-full bg-coin transition-all" style={{ width: `${(prog / 60) * 100}%` }} /></div>
        <p className="mt-2 text-xs text-muted">Next coin after {60 - prog}s. Timer pauses when the video is paused or the tab is hidden.</p>
      </div>
      {done && <p className="mt-4 rounded-lg bg-coin-soft px-3 py-2 text-sm">This video has received all the watch time it paid for.</p>}
      {check && (
        <div className="fixed inset-0 z-30 flex items-center justify-center bg-ink/70 p-6" role="dialog" aria-modal="true">
          <div className="w-full max-w-xs rounded-2xl bg-white p-6 text-center">
            <p className="text-xl font-bold">Are you watching?</p>
            <p className="mt-2 text-sm text-muted">Tap within {left}s to keep earning.</p>
            <button onClick={() => { setCheck(false); checking.current = false; since.current = 0; player.current?.playVideo(); }} className={btn + " mt-5"}>Yes, I'm watching</button>
          </div>
        </div>
      )}
    </div>
  );
}

function Wallet({ me, reload }: any) {
