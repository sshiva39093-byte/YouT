    if (error) return setMsg({ ok: false, t: error.message });
    setUtr(""); loadRows(); reload();
    setMsg({ ok: true, t: data === "credited" ? `${fmt(pkg.coins)} coins added.` : "UTR received. Coins are added once your payment is verified." });
  }
  return (
    <div className="px-5 pt-8">
      <div className="rounded-2xl bg-ink p-5 text-white"><p className="text-sm text-white/70">Coin balance</p><p className="text-4xl font-bold">{fmt(me.coins)}</p></div>
      <h2 className="mt-6 text-xl font-bold">Add coins</h2>
