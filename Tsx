        ))}
      </div>
      <div className="mt-5 rounded-2xl border border-line bg-white p-4">
        <p className="font-medium">1. Pay ₹{pkg.inr}</p>
        <a href={`phonepe://pay?${q}`} className="mt-3 block rounded-xl bg-[#5F259F] py-3 text-center font-semibold text-white">Pay ₹{pkg.inr} with PhonePe</a>
        <a href={`upi://pay?${q}`} className="mt-2 block text-center text-sm text-muted underline">Use another UPI app</a>
        <p className="mt-3 text-xs text-muted">Or pay manually to <b>{UPI}</b>. Send exactly ₹{pkg.inr}.</p>
        <p className="mt-5 font-medium">2. Enter your 12-digit UTR</p>
        <input value={utr} onChange={(x) => setUtr(x.target.value.replace(/\D/g, "").slice(0, 12))} inputMode="numeric" placeholder="412345678901" className={inp + " mt-2"} />
        {msg && <p role="alert" className={`mt-3 rounded-lg px-3 py-2 text-sm ${msg.ok ? "bg-green-50 text-ok" : "bg-red-50 text-bad"}`}>{msg.t}</p>}
        <button onClick={submit} disabled={busy || utr.length !== 12} className={btn + " mt-3"}>Submit UTR</button>
      </div>
      {rows.length > 0 && (<><h3 className="mt-6 font-medium">Recent payments</h3>
        <ul className="mt-2 space-y-2">{rows.map((r) => (
          <li key={r.utr} className="flex justify-between rounded-xl border border-line bg-white px-4 py-3 text-sm"><span>₹{r.amount_inr} · {r.utr}</span><span className="text-muted">{r.status === "auto_credited" ? "credited" : r.status}</span></li>
        ))}</ul></>)}
    </div>
  );
}

function Profile({ me, reload }: any) {
  const [err, setErr] = useState(""); const [busy, setBusy] = useState(false);
  async function upload(e: React.ChangeEvent<HTMLInputElement>) {
    const f = e.target.files?.[0]; if (!f) return;
    if (f.size > 2 * 1024 * 1024) return setErr("Choose an image under 2 MB.");
    setErr(""); setBusy(true);
    const path = `${me.id}/avatar.${f.name.split(".").pop()}`;
    const up = await supabase.storage.from("avatars").upload(path, f, { upsert: true, contentType: f.type });
    if (up.error) { setBusy(false); return setErr(up.error.message); }
    const url = supabase.storage.from("avatars").getPublicUrl(path).data.publicUrl + `?t=${Date.now()}`;
    const u = await supabase.from("profiles").update({ avatar_url: url }).eq("id", me.id);
    setBusy(false); if (u.error) setErr(u.error.message); else reload();
  }
  return (
    <div className="px-5 pt-10 text-center">
      <label className="relative mx-auto block h-28 w-28 cursor-pointer">
        {me.avatar_url
          // eslint-disable-next-line @next/next/no-img-element
          ? <img src={me.avatar_url} alt="Profile" className="h-28 w-28 rounded-full object-cover" />
          : <span className="flex h-28 w-28 items-center justify-center rounded-full bg-ink text-4xl font-bold text-white">{me.username[0].toUpperCase()}</span>}
        <span className="absolute bottom-0 right-0 rounded-full bg-coin px-2.5 py-1 text-xs font-semibold">{busy ? "..." : "Edit"}</span>
        <input type="file" accept="image/*" onChange={upload} className="sr-only" />
      </label>
      <h1 className="mt-4 text-2xl font-bold">@{me.username}</h1>
      <p className="text-muted">{fmt(me.coins)} coins</p>
      <Err t={err} />
      <button onClick={() => supabase.auth.signOut()} className="mt-6 w-full rounded-xl border border-line bg-white py-3 font-medium">Log out</button>
      {me.is_admin && <Admin />}
    </div>
  );
}

