export default function App() {
  const [ready, setReady] = useState(false);
  const [uid, setUid] = useState<string | null>(null);
  useEffect(() => {
    supabase.auth.getSession().then(({ data }) => { setUid(data.session?.user.id ?? null); setReady(true); });
    const { data: l } = supabase.auth.onAuthStateChange((_e, s) => setUid(s?.user.id ?? null));
    return () => l.subscription.unsubscribe();
  }, []);
  if (!ready) return null;
  return uid ? <Main uid={uid} /> : <Auth />;
}

function Auth() {
  const [signup, setSignup] = useState(false);
  const [u, setU] = useState(""); const [e, setE] = useState(""); const [p, setP] = useState("");
  const [err, setErr] = useState(""); const [busy, setBusy] = useState(false);

  async function submit(ev: React.FormEvent) {
    ev.preventDefault(); setErr("");
    if (signup) {
      if (!/^[a-zA-Z0-9_]{3,20}$/.test(u)) return setErr("Username: 3-20 letters, numbers or _");
      const { data } = await supabase.rpc("username_available", { u });
      if (!data) return setErr("That username is taken.");
    }
    setBusy(true);
    const r = signup
      ? await supabase.auth.signUp({ email: e, password: p, options: { data: { username: u } } })
      : await supabase.auth.signInWithPassword({ email: e, password: p });
    setBusy(false);
    if (r.error) return setErr(r.error.message);
    if (signup && !r.data.session) setErr("Account created. Turn off 'Confirm email' in Supabase, then log in.");
  }

  return (
    <main className="mx-auto flex min-h-screen max-w-md flex-col justify-center px-6 py-10">
      <div className="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-coin text-xl font-bold">₵</div>
      <h1 className="text-3xl font-bold">{signup ? "Start with 200 free coins" : "Welcome back"}</h1>
      <p className="mb-6 mt-2 text-muted">{signup ? "Watch videos to earn coins. Spend coins to get your videos watched." : "Log in to keep earning."}</p>
      <form onSubmit={submit} className="space-y-4">
        {signup && (<div><label className="mb-1 block text-sm font-medium">Username</label>
          <input className={inp} value={u} onChange={(x) => setU(x.target.value)} autoComplete="username" /></div>)}
        <div><label className="mb-1 block text-sm font-medium">Email</label>
          <input type="email" required className={inp} value={e} onChange={(x) => setE(x.target.value)} autoComplete="email" /></div>
        <div><label className="mb-1 block text-sm font-medium">Password</label>
          <input type="password" required minLength={6} className={inp} value={p} onChange={(x) => setP(x.target.value)} autoComplete={signup ? "new-password" : "current-password"} /></div>
        <Err t={err} />
        <button disabled={busy} className={btn}>{busy ? "Please wait..." : signup ? "Create account" : "Log in"}</button>
      </form>
      <button onClick={() => { setSignup(!signup); setErr(""); }} className="mt-6 text-center text-sm text-muted underline">
        {signup ? "Already have an account? Log in" : "New here? Create an account"}
      </button>
    </main>
  );
}

