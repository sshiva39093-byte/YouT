import { NextResponse } from "next/server";

export async function GET(req: Request) {
  const url = new URL(req.url).searchParams.get("url") ?? "";
  const m = url.match(/(?:youtu\.be\/|v=|shorts\/|embed\/)([A-Za-z0-9_-]{11})/);
  if (!m) return NextResponse.json({ error: "Paste a valid YouTube link." }, { status: 400 });
  const id = m[1];
  const r = await fetch(`https://www.youtube.com/oembed?url=https://www.youtube.com/watch?v=${id}&format=json`);
  if (!r.ok) return NextResponse.json({ error: "Video not found or not embeddable." }, { status: 404 });
  const j = await r.json();
  return NextResponse.json({ id, title: j.title, thumbnail: `https://i.ytimg.com/vi/${id}/hqdefault.jpg` });
}
